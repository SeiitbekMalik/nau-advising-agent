# Copy this file to .env and fill in what you need. Everything is optional:
# with no API key the assistant runs in offline "extractive" mode.

# LLM provider: extractive | anthropic | openai  (leave empty to auto-detect from the keys below)
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Retrieval tuning
TOP_K=4
MIN_COVERAGE=0.25

# Storage
# DB_PATH=data/advising.db
# KB_DIR=data/kb
